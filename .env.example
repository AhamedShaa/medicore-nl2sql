# ============================================================
# MediCore NL2SQL Platform — Environment Variables
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your real values below
# 3. NEVER commit .env to git (it's in .gitignore)
#
# All non-secret settings live in config/params.yaml.
# Only secrets (API keys) belong here.
# ============================================================

# --- OpenRouter (required) ---
# Get your free key at https://openrouter.ai/keys
# Model is configured in config/params.yaml (default: openai/gpt-4o)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- LangFuse Observability (optional) ---
# Without these, traces are saved locally to traces/ folder only.
# Get keys at https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here

# --- Database (optional overrides) ---
# Default is ./medicore.db (SQLite). Override here for production PostgreSQL.
# DB_PATH=./medicore.db
# DB_PATH=postgresql+psycopg2://user:password@host:5432/medicore

# --- Multi-turn memory (optional override) ---
# Default is ./data/conversations.db locally and /app/data/conversations.db in Docker.
# MEMORY_DB_PATH=./data/conversations.db

# --- Logging (optional override) ---
# Overrides logging.level in params.yaml. Values: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=DEBUG
